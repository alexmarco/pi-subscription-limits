{
  "name": "pi-subscription-limits",
  "version": "1.0.0",
  "description": "Pi Atelier sidebar panel for Codex and Claude subscription limits",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-atelier",
    "subscription-limits"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexmarco/pi-subscription-limits.git"
  },
  "homepage": "https://github.com/alexmarco/pi-subscription-limits#readme",
  "bugs": {
    "url": "https://github.com/alexmarco/pi-subscription-limits/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.cjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "pi-atelier": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
